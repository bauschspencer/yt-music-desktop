<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ytmusicdesktop</groupId>
    <artifactId>ytmusic-desktop</artifactId>
    <!-- Installers only upgrade an existing install when this increases (numeric x.y.z only). -->
    <version>0.5.1</version>
    <name>YT Music Desktop</name>

    <properties>
        <!-- 22+ for the Foreign Function & Memory API (taskbar buttons, registry). -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Chromium: update both together (see "Updating Chromium" in SCOPE.md). jcef.version is
            the jcef-api version that jcefmaven depends on, which names the matching natives.
        -->
        <jcefmaven.version>152.0.6</jcefmaven.version>
        <jcef.version>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</jcef.version>
        <main.class>com.ytmusicdesktop.App</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>${jcefmaven.version}</version>
        </dependency>
        <!--
            Chromium itself (a 170 MB jar holding a .tar.gz), unpacked into the app image at build
            time so the app never downloads it. Provided: the jar itself isn't shipped.
        -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcef-natives-windows-amd64</artifactId>
            <version>${jcef.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>ytmusic-desktop</finalName>
        <resources>
            <!-- version.properties gets the pom version filled in; nothing else is filtered. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!--
                Before anything else (validate phase), checks the PGP signature on every dependency,
                Chromium's jar included, against the keys pinned in pgp-keys.list. Central's checksums
                come from the same server as the files, so only a signature, which needs the
                publisher's private key, shows a file wasn't replaced there or on the way. A dependency
                that isn't listed fails the build; see "Updating Chromium" in SCOPE.md.
            -->
            <plugin>
                <groupId>org.simplify4u.plugins</groupId>
                <artifactId>pgpverify-maven-plugin</artifactId>
                <version>1.19.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <keysMapLocations>
                        <keysMapLocation>${project.basedir}/src/main/packaging/pgp-keys.list</keysMapLocation>
                    </keysMapLocations>
                    <!-- The Chromium jar is a provided dependency, which isn't checked by default. -->
                    <verifyProvidedDependencies>true</verifyProvidedDependencies>
                    <!--
                        Check every time (under a second). The plugin otherwise skips artifacts it
                        passed before, even after a key is changed in pgp-keys.list.
                    -->
                    <disableChecksum>true</disableChecksum>
                </configuration>
            </plugin>

            <!-- Packaging: gather the app jar and its dependencies into target/app for jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/app</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- jpackage refuses to overwrite an existing app image, so clear it first. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>clean-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/dist</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <!-- `mvn compile exec:exec` launches the app in a separate JVM so JVM flags apply. -->
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <!-- Compile scope includes the natives jar, which a dev run unpacks Chromium from. -->
                            <classpathScope>compile</classpathScope>
                            <executable>java</executable>
                            <arguments>
                                <!-- Keep in sync with the jpackage java-options below. -->
                                <argument>-XX:+DisableAttachMechanism</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>--add-exports=java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--add-exports=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-exports=java.desktop/sun.java2d=ALL-UNNAMED</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${main.class}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!--
                        Unpacks Chromium into target/app/jcef-bundle, which jpackage copies into the
                        image as app/jcef-bundle; the installed app loads it from there. Skipped when
                        the folder already holds this version.
                    -->
                    <execution>
                        <id>bundle-natives</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <classpathScope>compile</classpathScope>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${project.basedir}/src/main/packaging/BundleNatives.java</argument>
                                <argument>${project.build.directory}/app/jcef-bundle</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- `mvn package` builds target/dist/YT Music/YT Music.exe with a bundled Java runtime. -->
                    <execution>
                        <id>jpackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/jpackage</executable>
                            <arguments>
                                <argument>--type</argument>
                                <argument>app-image</argument>
                                <argument>--name</argument>
                                <argument>YT Music</argument>
                                <argument>--app-version</argument>
                                <argument>${project.version}</argument>
                                <argument>--icon</argument>
                                <argument>${project.basedir}/src/main/packaging/app.ico</argument>
                                <argument>--input</argument>
                                <argument>${project.build.directory}/app</argument>
                                <argument>--main-jar</argument>
                                <argument>${project.build.finalName}.jar</argument>
                                <argument>--main-class</argument>
                                <argument>${main.class}</argument>
                                <!--
                                    No attaching to the running app (jcmd, a -javaagent loaded later):
                                    another process running as the user could otherwise read the
                                    signed-in session out of its memory.
                                -->
                                <argument>--java-options</argument>
                                <argument>-XX:+DisableAttachMechanism</argument>
                                <argument>--java-options</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>--java-options</argument>
                                <argument>--add-exports=java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--java-options</argument>
                                <argument>--add-exports=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--java-options</argument>
                                <argument>--add-exports=java.desktop/sun.java2d=ALL-UNNAMED</argument>
                                <argument>--dest</argument>
                                <argument>${project.build.directory}/dist</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `mvn package -Pinstaller` also wraps the app image in an .msi (target/installer).
            Needs WiX Toolset on PATH, so it runs in GitHub Actions (.github/workflows/release.yml);
            Smart App Control blocks WiX on the dev machine.
        -->
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--app-image</argument>
                                        <argument>${project.build.directory}/dist/YT Music</argument>
                                        <argument>--name</argument>
                                        <argument>YT Music</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Spencer Bausch</argument>
                                        <argument>--description</argument>
                                        <argument>YouTube Music desktop app</argument>
                                        <!-- Never change: it's how Windows knows a new .msi upgrades the old install. -->
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>4e0e1895-9422-49b9-a05c-4419e7cd7972</argument>
                                        <!-- Installs under the user's profile, so no admin prompt. -->
                                        <argument>--win-per-user-install</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-shortcut-prompt</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
