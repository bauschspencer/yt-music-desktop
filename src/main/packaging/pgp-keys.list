org.apache.commons:commons-compress = 0x2DB4 F1EF 0FA7 61EC C4EA  935C 86FD C7E2 A112 62CB
org.apache.commons:commons-lang3    = 0x2DB4 F1EF 0FA7 61EC C4EA  935C 86FD C7E2 A112 62CB
commons-codec:commons-codec         = 0x2DB4 F1EF 0FA7 61EC C4EA  935C 86FD C7E2 A112 62CB
commons-io:commons-io               = 0x2DB4 F1EF 0FA7 61EC C4EA  935C 86FD C7E2 A112 62CB

